 {
  "cell": 12,
  "n": 12,
  "source": "from sklearn.compose import ColumnTransformer\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.pipeline import make_pipeline\n\nnumeric = [\"sqft\", \"beds\", \"built\", \"garage\", \"condition\", \"months\"]\nnumbers = make_pipeline(SimpleImputer(strategy=\"median\"), StandardScaler())\nprepare = ColumnTransformer([\n    (\"numbers\", numbers, numeric),\n    (\"area\", OneHotEncoder(), [\"area\"]),\n])\nprepare",
  "outputs": [
   {
    "type": "result",
    "text": "ColumnTransformer(transformers=[('numbers',\n                                 Pipeline(steps=[('simpleimputer',\n                                                  SimpleImputer(strategy='median')),\n                                                 ('standardscaler',\n                                                  StandardScaler())]),\n                                 ['sqft', 'beds', 'built', 'garage',\n                                  'condition', 'months']),\n                                ('area', OneHotEncoder(), ['area'])])"
   }
  ]
 },
 {
  "cell": 13,
  "n": 13,
  "source": "ready = prepare.fit_transform(X_train)\nready.shape, prepare.get_feature_names_out().tolist()",
  "outputs": [
   {
    "type": "result",
    "text": "((1162, 11),\n ['numbers__sqft',\n  'numbers__beds',\n  'numbers__built',\n  'numbers__garage',\n  'numbers__condition',\n  'numbers__months',\n  'area__area_Eastfield',\n  'area__area_Hillcrest',\n  'area__area_Northgate',\n  'area__area_Old Town',\n  'area__area_Riverside'])"
   }
  ]
 },
 {
  "cell": 14,
  "n": 14,
  "source": "from sklearn.metrics import mean_absolute_error\n\nguess = np.full(len(y_test), y_train.median())\nround(mean_absolute_error(y_test, guess))",
  "outputs": [
   {
    "type": "result",
    "text": "59581"
   }
  ]
 },
 {
  "cell": 15,
  "n": 15,
  "source": "line = LinearRegression().fit(X_train[[\"sqft\"]], y_train)\npredicted = line.predict(X_test[[\"sqft\"]])\nerror = mean_absolute_error(y_test, predicted)\nround(line.intercept_), round(line.coef_[0], 1), round(error)",
  "outputs": [
