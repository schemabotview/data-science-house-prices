  ]
 },
 {
  "cell": 6,
  "n": 6,
  "source": "from sklearn.linear_model import LinearRegression\n\ndef log_features(X, y):\n    return pd.DataFrame({\n        \"log_sqft\": np.log(X[\"sqft\"]),\n        \"log_per_sqft\": np.log(y / X[\"sqft\"]),\n    })\n\nleaky = LinearRegression().fit(log_features(X_train, y_train), np.log(y_train))\nround(leaky.score(log_features(X_test, y_test), np.log(y_test)), 4)",
  "outputs": [
   {
    "type": "result",
    "text": "1.0"
   }
  ]
 },
 {
  "cell": 7,
  "n": 7,
  "source": "honest = LinearRegression().fit(np.log(X_train[[\"sqft\"]]), np.log(y_train))\nround(honest.score(np.log(X_test[[\"sqft\"]]), np.log(y_test)), 4)",
  "outputs": [
