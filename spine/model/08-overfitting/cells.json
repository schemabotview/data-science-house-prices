 {
  "cell": 1,
  "n": 1,
  "source": "import numpy as np\nimport pandas as pd\n\nhomes = pd.read_csv(\"../data/homes_clean.csv\", parse_dates=[\"sold\"])\nhomes[\"area\"] = homes[\"area\"].str.title()\nhomes[\"months\"] = (homes[\"sold\"].dt.year - 2021) * 12 + homes[\"sold\"].dt.month - 1",
  "outputs": []
 },
