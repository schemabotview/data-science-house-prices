 {
  "cell": 11,
  "n": 11,
  "source": "garage = homes[\"garage\"] > 0\nprices = homes[\"price\"]\nobserved = prices[garage].median() - prices[~garage].median()\nobserved",
  "outputs": [
   {
    "type": "result",
    "text": "np.float64(13050.0)"
   }
  ]
 },
 {
  "cell": 12,
  "n": 12,
  "source": "def shuffled_differences(prices, flags, n=5000, seed=1460):\n    \"\"\"Median difference between the flagged and the rest, with the flags shuffled.\"\"\"\n    rng = np.random.default_rng(seed)\n    values, flags = np.asarray(prices), np.asarray(flags)\n    out = np.empty(n)\n    for i in range(n):\n        f = rng.permutation(flags)\n        out[i] = np.median(values[f]) - np.median(values[~f])\n    return out\n\ndiffs = shuffled_differences(prices, garage)\n(np.abs(diffs) >= abs(observed)).mean()",
  "outputs": [
   {
    "type": "result",
    "text": "np.float64(0.0036)"
   }
  ]
 },
